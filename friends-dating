        function updateCard() {
            if (currentDeck.length === 0) {
                frontWordElement.textContent = "No cards";
                backWordElement.textContent = "No cards";
                frontTypeElement.textContent = "";
                backTypeElement.textContent = "";
                counterElement.textContent = "0 / 0";
                return;
            }

            cardElement.classList.remove('is-flipped');
            
            setTimeout(() => {
                const card = currentDeck[currentIndex];
                
                if (spanishFirst) {
                    frontWordElement.textContent = card.es;
                    backWordElement.textContent = card.en;
                } else {
                    frontWordElement.textContent = card.en;
                    backWordElement.textContent = card.es;
                }

                frontTypeElement.textContent = card.type;
                backTypeElement.textContent = card.type;
                counterElement.textContent = `${currentIndex + 1} / ${currentDeck.length}`;
            }, 150);
        }

        function flipCard() {
            if (currentDeck.length > 0) {
                cardElement.classList.toggle('is-flipped');
            }
        }

